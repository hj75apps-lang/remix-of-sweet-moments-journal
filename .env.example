# Frontend-visible Google Maps configuration. Revoked/Removed.
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_BROWSER_KEY=
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_TRACKING_ID=

# Server-only Navigation Connect configuration. Never expose these as VITE_* variables.
GOOGLE_NAVIGATION_CONNECT_PROJECT_ID=
GOOGLE_NAVIGATION_CONNECT_ANDROID_APP_ID=app.smartautolauncher
GOOGLE_NAVIGATION_CONNECT_SERVICE_ACCOUNT_JSON=

# Optional remote API base for a static/Capacitor build. Leave empty when the launcher is served by the same host.
VITE_NAVIGATION_CONNECT_API_BASE=

NAVIGATION_CONNECT_ALLOWED_ORIGIN=https://localhost

# Random server-only secret (minimum 32 characters) used to sign short-lived Navigation Connect capabilities.
NAVIGATION_CONNECT_SESSION_SECRET=

# SHA-256 hashes of provisioned creator credentials, keyed by device/user ID.
# Never place the corresponding plaintext credentials in VITE_* variables or this file.
NAVIGATION_CONNECT_CREATOR_KEYS_JSON=

# NAVIGATION_CONNECT_QUOTA is a private service binding, not a string env var.
# See docs/SEGURANCA-NAVIGATION-CONNECT.md for the SQLite quota service and provisioning.

# Native APK build-time trust configuration. Public key only; never put the signing private key here.
OTA_MANIFEST_URL=
OTA_PUBLIC_KEY=
OTA_CHANNEL=production
OTA_BUILTIN_SEQUENCE=0
