# Frontend-visible Google Maps configuration. Restrict browser keys by API and referrer.
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_BROWSER_KEY=
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_TRACKING_ID=

# Server-only Navigation Connect configuration. Never expose these as VITE_* variables.
GOOGLE_NAVIGATION_CONNECT_PROJECT_ID=
GOOGLE_NAVIGATION_CONNECT_ANDROID_APP_ID=app.smartautolauncher
GOOGLE_NAVIGATION_CONNECT_SERVICE_ACCOUNT_JSON=

# Optional remote API base for a static/Capacitor build. Leave empty when the launcher is served by the same host.
VITE_NAVIGATION_CONNECT_API_BASE=

NAVIGATION_CONNECT_ALLOWED_ORIGIN=https://localhost
